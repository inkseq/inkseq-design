-463d-9f0f-f4a83ae081ec\",\"sourceShotId\":\"shot-34a2b5dace0d4be4a6f0fdb653442094\",\"sourceShotVersion\":1},\"description\":\"\",\"id\":\"result-485371ea-52fb-4ba2-b93c-1eeae7c4414a\",\"order\":53,\"parentId\":null,\"status\":\"draft\",\"title\":\"Generated result\",\"type\":\"video\",\"version\":1},{\"data\":{\"anchors\":[\"三身人画面左边的头\",\"黑色短卷发、胡茬、方下巴、总皱眉\",\"锈橙色毛线围巾，从头到尾不换\",\"常拿木棍：画面最左那只手，是他的右手\"],\"body\":{\"arms\":2,\"heads\":1,\"legs\":null,\"line\":\"和另外两兄弟共用一个身体：三个上身在一个宽胯处相连，一条齐膝羊毛短裙，一双腿；自己有 1 个头、2 只手。\"},\"defaultLookId\":\"main\",\"groupId\":\"三兄弟\",\"looks\":[{\"description\":\"深色短卷发、胡茬、方下巴、皱眉，铁锈橙粗线围巾\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-71e02756-48f9-490b-9601-6b4a5231526c\"],\"name\":\"默认造型\",\"version\":3}],\"mainVoiceId\":\"voice-d714907e-c921-49e4-b036-41b9382d18a1\",\"speaker\":\"S1\",\"voices\":[{\"assetId\":\"audio-39bf4afe-efa9-4dd9-baf5-2cef8878e5e5\",\"clipStart\":0,\"id\":\"voice-d714907e-c921-49e4-b036-41b9382d18a1\"}]},\"description\":\"老大（左边的头）：深色短卷发，下巴有胡茬，方下巴，总是皱着眉。系一条铁锈橙色的粗线编织围巾。\\n三兄弟共用一个身体：三个并排的赤裸上身，各穿一件无袖、未染色的米白羊毛背心，在一个宽胯处连成一体；下身是一条齐膝、毛蓬蓬的羊毛短裙，只有一双腿。三个头始终一样高，从不分开。\",\"id\":\"character-ee3848c3-afa6-43de-ad44-94103cf3b9e1\",\"order\":54,\"parentId\":null,\"status\":\"review\",\"title\":\"老大\",\"type\":\"character\",\"version\":18},{\"data\":{\"anchors\":[\"三身人中间的头\",\"圆脸、几乎秃、眼神软\",\"天蓝色毛线围巾，从头到尾不换\",\"多数时候空手（摸阿花、举手掌）\"],\"body\":{\"arms\":2,\"heads\":1,\"legs\":null,\"line\":\"和另外两兄弟共用一个身体：三个上身在一个宽胯处相连，一条齐膝羊毛短裙，一双腿；自己有 1 个头、2 只手。\"},\"defaultLookId\":\"main\",\"groupId\":\"三兄弟\",\"looks\":[{\"description\":\"圆脸、几乎光头、面相和善，天蓝粗线围巾\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-934d3e23-e4c2-4147-8e69-18f07851e0ed\"],\"name\":\"默认造型\",\"version\":3}],\"mainVoiceId\":\"voice-456e27fa-bc58-4283-a81a-4a01ca50f5f7\",\"speaker\":\"S2\",\"voices\":[{\"assetId\":\"audio-5a8fd858-6dec-44b6-9c1c-a6573e81b21e\",\"clipStart\":0,\"id\":\"voice-456e27fa-bc58-4283-a81a-4a01ca50f5f7\"}]},\"description\":\"老二（中间的头）：圆脸，几乎光头，面相柔和善良。系一条天蓝色的粗线编织围巾。\\n三兄弟共用一个身体：三个并排的赤裸上身，各穿一件无袖、未染色的米白羊毛背心，在一个宽胯处连成一体；下身是一条齐膝、毛蓬蓬的羊毛短裙，只有一双腿。三个头始终一样高，从不分开。\",\"id\":\"character-35670626-f33c-42e1-af41-9ffef520621f\",\"order\":55,\"parentId\":null,\"status\":\"review\",\"title\":\"老二\",\"type\":\"character\",\"version\":18},{\"data\":{\"anchors\":[\"三身人画面右边的头\",\"一头大黑卷发、满脸黑胡子、胖脸\",\"芥末黄毛线围巾，从头到尾不换\",\"常拿圆面包：画面最右那只手，是他的左手\"],\"body\":{\"arms\":2,\"heads\":1,\"legs\":null,\"line\":\"和另外两兄弟共用一个身体：三个上身在一个宽胯处相连，一条齐膝羊毛短裙，一双腿；自己有 1 个头、2 只手。\"},\"defaultLookId\":\"main\",\"groupId\":\"三兄弟\",\"looks\":[{\"description\":\"浓密黑色大卷发、满脸浓黑大胡子，芥末黄粗线围巾\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-71e02756-48f9-490b-9601-6b4a5231526c\"],\"name\":\"默认造型\",\"version\":3}],\"mainVoiceId\":\"voice-f441e24c-392d-4894-bd65-8924be91fb3f\",\"speaker\":\"S3\",\"voices\":[{\"assetId\":\"audio-60f3a118-97f5-418c-a43a-62855ffc1b77\",\"clipStart\":0,\"id\":\"voice-f441e24c-392d-4894-bd65-8924be91fb3f\"}]},\"description\":\"老三（右边的头）：一头浓密的黑色大卷发，满脸浓黑的大胡子。系一条芥末黄的粗线编织围巾。\\n三兄弟共用一个身体：三个并排的赤裸上身，各穿一件无袖、未染色的米白羊毛背心，在一个宽胯处连成一体；下身是一条齐膝、毛蓬蓬的羊毛短裙，只有一双腿。三个头始终一样高，从不分开。\",\"id\":\"character-30e29c00-a912-4090-93a3-f3b85abcec5e\",\"order\":56,\"parentId\":null,\"status\":\"review\",\"title\":\"老三\",\"type\":\"character\",\"version\":18},{\"data\":{\"bytes\":441078,\"cloudAssetId\":\"783ca15d83f343d49c1403d667b56589\",\"cloudContentPath\":\"/v1/assets/783ca15d83f343d49c1403d667b56589/content\",\"fileId\":\"cloud_asset_783ca15d83f343d49c1403d667b56589\",\"fileName\":\"gy_a_c08_da.wav\",\"metadata\":{\"audio_stream_index\":0,\"bytes\":441078,\"channels\":2,\"duration\":5,\"has_audio\":true,\"kind\":\"audio\",\"mime\":\"audio/wav\",\"model_ready\":true,\"notes\":[\"模型副本为32kHz双声道，原音频保留\"],\"sample_rate\":32000,\"sha256\":\"e55f7fa47ca9796d9fe069e72dfa39117c66af424a6105e18aac1a13f62cbdb7\",\"source_duration\":5,\"video_stream_index\":null},\"mime\":\"audio/wav\",\"missingFile\":false,\"source\":\"upload\",\"storyboardInbox\":false},\"description\":\"\",\"id\":\