      "size": -1,
      "mimeType": "application/json",
      "text": "{\"id\":\"project-70e55fda6b704c9ea5cafe2727ae9bbf\",\"version\":90,\"updated_at\":1794250578.6241229,\"project\":{\"entities\":[{\"data\":{},\"description\":\"\",\"id\":\"chapter-f344db71b5895957bd5a446d18a93568\",\"order\":0,\"parentId\":null,\"status\":\"draft\",\"title\":\"故事\",\"type\":\"chapter\",\"version\":1},{\"data\":{\"script\":\"\"},\"description\":\"\",\"id\":\"scene-57ec766d14545d9b9eab490902f7297f\",\"order\":0,\"parentId\":\"chapter-f344db71b5895957bd5a446d18a93568\",\"status\":\"draft\",\"title\":\"场景 1\",\"type\":\"scene\",\"version\":2},{\"data\":{\"defaultLookId\":\"main\",\"looks\":[{\"description\":\"\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-pic-ec0eef6d51c9-a-c473539c7f0fdc\"],\"name\":\"默认造型\",\"version\":2}],\"mainVoiceId\":\"voice-3dca7fb2-9604-47a5-bbe0-ddcdcdcdc06a\",\"voices\":[{\"assetId\":\"audio-99a48757-1c9c-4fdd-a755-09c17008f700\",\"clipStart\":0,\"id\":\"voice-3dca7fb2-9604-47a5-bbe0-ddcdcdcdc06a\"}]},\"description\":\"身材矮小瘦削的古希腊风老妇人，满头白发苍苍，脸颊布满皱纹，身穿粗灰麻布长袍，神情担忧哀伤。\",\"id\":\"character-086daf5ad48c490a9bc473539c7f0fdc\",\"order\":2,\"parentId\":null,\"status\":\"review\",\"title\":\"阿妈\",\"type\":\"character\",\"version\":3},{\"data\":{\"defaultLookId\":\"main\",\"groupId\":\"\",\"looks\":[{\"description\":\"\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-pic-ec0eef6d51c9-a-a42cf540d8c8e1\"],\"name\":\"默认造型\",\"version\":2}],\"mainVoiceId\":\"\",\"voices\":[]},\"description\":\"体型魁梧冷酷的健硕男子，头戴并身披整张雄狮毛皮，肩背长弓与箭筒，神情冷峻寡言，身着古代猎人粗布绑腿。\",\"id\":\"character-820348f8c2124cbb9ba42cf540d8c8e1\",\"order\":3,\"parentId\":null,\"status\":\"review\",\"title\":\"狮皮人\",\"type\":\"character\",\"version\":4},{\"data\":{\"ambient\":null,\"defaultVersionId\":\"main\",\"versions\":[{\"description\":\"\",\"id\":\"main\",\"imageIds\":[\"image-pic-ec0eef6d51c9-a-4a9e676a8e539a\"],\"name\":\"默认\",\"version\":2}]},\"description\":\"海岛沿岸开阔的金黄色荒草地，带有一座由粗糙乱石堆砌而成的简陋矮牛圈，木栅门破损敞开，泥土上混杂着牛蹄印与大脚印。\",\"id\":\"location-e283f27ad19146f6ba4a9e676a8e539a\",\"order\":4,\"parentId\":null,\"status\":\"draft\",\"title\":\"草地与石砌牛圈\",\"type\":\"location\",\"version\":2},{\"data\":{\"ambient\":null,\"defaultVersionId\":\"main\",\"versions\":[{\"description\":\"\",\"id\":\"main\",\"imageIds\":[\"image-pic-ec0eef6d51c9-a-a58f4749b28b2e\"],\"name\":\"默认\",\"version\":2}]},\"description\":\"爱琴海荒凉海岛风格的低矮石砌石屋前，门前有一张粗木凳，泥土小径蜿蜒通向荒原与海边。\",\"id\":\"location-d3295041469e48d49aa58f4749b28b2e\",\"order\":5,\"parentId\":null,\"status\":\"draft\",\"title\":\"石屋门口\",\"type\":\"location\",\"version\":2},{\"data\":{\"ambient\":null,\"defaultVersionId\":\"main\",\"versions\":[{\"description\":\"\",\"id\":\"main\",\"imageIds\":[\"image-pic-ec0eef6d51c9-a-69089c5bc77c09\"],\"name\":\"默认\",\"version\":2}]},\"description\":\"粗砂与碎石海滩，海浪拍打岸边，停靠着一艘简陋的古代木质货船，视野开阔苍凉。\",\"id\":\"location-5ff7964ecb3e426ca069089c5bc77c09\",\"order\":6,\"parentId\":null,\"status\":\"draft\",\"title\":\"海滩\",\"type\":\"location\",\"version\":2},{\"data\":{\"imageIds\":[\"image-pic-ec0eef6d51c9-a-0d058e29e89460\"]},\"description\":\"古代粗麦烤制的干硬圆形粗粮面包。\",\"id\":\"prop-6bfa25ffe91b49ae9a0d058e29e89460\",\"order\":7,\"parentId\":null,\"status\":\"draft\",\"title\":\"圆面包\",\"type\":\"prop\",\"version\":2},{\"data\":{\"imageIds\":[\"image-pic-ec0eef6d51c9-a-1ee7e82b4dd5f4\"]},\"description\":\"手工粗纺毛线织就的磨旧浅蓝色围巾。\",\"id\":\"prop-62b50acf6a484d56a51ee7e82b4dd5f4\",\"order\":8,\"parentId\":null,\"status\":\"draft\",\"title\":\"蓝围巾\",\"type\":\"prop\",\"version\":2},{\"data\":{\"imageIds\":[\"image-pic-ec0eef6d51c9-a-db87fc55d2b52c\"]},\"description\":\"猎人使用的简朴粗木强弓与锋利的倒钩羽箭。\",\"id\":\"prop-1bb350643ba341ebaddb87fc55d2b52c\",\"order\":9,\"parentId\":null,\"status\":\"draft\",\"title\":\"弓与箭\",\"type\":\"prop\",\"version\":2},{\"data\":{\"candidateIds\":[\"result-299c242c-bc91-4c09-9d4e-471a538384c7\"],\"cast\":[{\"characterId\":\"character-ee3848c3-afa6-43de-ad44-94103cf3b9e1\",\"lookId\":\"\"},{\"characterId\":\"character-35670626-f33c-42e1-af41-9ffef520621f\",\"lookId\":\"\"},{\"characterId\":\"character-30e29c00-a912-4090-93a3-f3b85abcec5e\",\"lookId\":\"\"}],\"h3\":{\"controls\":{\"duration\":6}},\"prompt\":\"黄昏斜阳逆光，广角低机位跟拍，三兄弟肩并肩赶着一群红牛在草地上前行，左边老大粗暴瞪牛喊道(S1) <d>[Chinese] 今天吃牛。</d>，中间老二弱声护道(S2) <d>[Chinese] 那是阿花。</d>，右边老三咀嚼着面包慢吞吞嘟囔(S3) <d>[Chinese] 有面包。</d>。\",\"seconds\":6.583333333333333,\"selectedAssetId\":\"result-299c242c-bc91-4c09-9d4e-471a538384c7\",\"selectedVideoRange\":{\"assetId\":\"result-299c242c-bc91-4c09-9d4e-471a538384c7\",\"cloudArtifactId\":\"299c242c-bc91-4c09-9d4e-471a538384c7\",\"cloudAssetId\":null,\"end\":6.583333333333333,\"fileId\":\"cloud_artifact_299c242c-bc91-4c09-9d4e-471a538384c7\",\"start\":0},\"storyboard\":{\"dialogueTrack\":{\"entityId\":\"dialogue-track-s01\"},\"extraRefs\":[],\"mode\":\"ref\",\"place\":{\"locationId\":\"location-e283f27ad19146f6ba4a9e676a8e539a\"},\"propIds\":[\"prop-6bfa25ffe91b49ae9a0d058e29e89460\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"黄昏斜阳逆光，广角低机位跟拍，三兄弟肩并肩赶着一群红牛在草地上前行，左边老大粗暴瞪牛喊道(S1) <d>[Chinese] 今天吃牛。</d>，中间老二弱声护道(S2) <d>[Chinese] 那是阿花。</d>，右边老三咀嚼着面包慢吞吞嘟囔(S3) <d>[Chinese] 有面包。</d>。\",\"id\":\"shot-d9bd124849764ea1bd2b96331cc97615\",\"order\":0,\"parentId\":\"scene-57ec766d14545d9b9eab490902f7297f\",\"status\":\"review\",\"title\":\"\",\"type\":\"shot\",\"version\":36},{\"data\":{\"candidateIds\":[\"result-75868990-ee17-4876-822d-6a0abdf8b449\"],\"cast\":[{\"characterId\":\"character-ee3848c3-afa6-43de-ad44-94103cf3b9e1\",\"lookId\":\"\"},{\"characterId\":\"character-35670626-f33c-42e1-af41-9ffef520621f\",\"lookId\":\"\"},{\"characterId\":\"character-30e29c00-a912-4090-93a3-f3b85abcec5e\",\"lookId\":\"\"}],\"prompt\":\"黄昏逆光，中景横移，三兄弟停在石砌牛圈敞开的木栅门前，老二惊恐张望低呼(S2) <d>[Chinese] 阿花呢？</d>，老大与老三闭嘴不语。\",\"seconds\":4,\"selectedAssetId\":\"result-75868990-ee17-4876-822d-6a0abdf8b449\",\"storyboard\":{\"dialogueTrack\":{\"entityId\":\"dialogue-track-s02\"},\"extraRefs\":[],\"mode\":\"ref\",\"place\":{\"locationId\":\"location-e283f27ad19146f6ba4a9e676a8e539a\"},\"p