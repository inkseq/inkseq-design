      "size": -1,
      "mimeType": "application/json",
      "text": "{\"jobs\":[{\"id\":\"fe8999d4-defc-4278-90c4-bbf5f4503999\",\"status\":\"succeeded\",\"created_at\":1793105591.7611911,\"updated_at\":1793145172.4099393,\"request_hash\":\"f322f0d07e36fef0193c670dab908d43f8c5ccbb27e9e5b062935e0598cbf438\",\"error_code\":null,\"result\":{\"artifact_ids\":[\"05e31c44-3dff-4470-b7f7-50fdc36e8fe5\",\"3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\"],\"billing_status\":\"pending\",\"completed_after_cancel_request\":false,\"project_collection\":{\"version\":1,\"status\":\"bound\",\"entity_ids\":[\"result-05e31c44-3dff-4470-b7f7-50fdc36e8fe5\",\"result-3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\"],\"project_version\":9,\"selected_entity_id\":\"result-3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\"}},\"created\":null,\"capacity_reclaim_count\":0,\"admission\":\"usd\",\"client_ref\":{\"chapter_id\":\"chapter-ebbac113d8d3590092dddc4133fc8c6d\",\"project_id\":\"project-1d39fa642bb64f3babc89de38cc621a2\",\"scene_id\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"shot_id\":\"shot-938a545b754e400681a1bd5dac8a6cb0\",\"shot_version\":1},\"phase\":\"succeeded\",\"recipe_id\":\"video-ref-v1\",\"effective_request\":{\"aspect_ratio\":\"16:9\",\"audio_conditioning\":\"reference\",\"audio_decode\":\"normal\",\"audio_excerpts\":[],\"audio_refinement\":\"none\",\"denoise\":1,\"duration\":5,\"encoder_device\":\"default\",\"export_crf\":18,\"generate_audio\":true,\"guides\":[],\"image_refs_relative_size\":100,\"inputs\":{\"audios\":[],\"first_frame\":null,\"images\":[\"bdd681dff19c4fb5974fdd6577f2b06c\"],\"last_frame\":null,\"videos\":[]},\"mask_mode\":\"grouped_rows\",\"mode\":\"ref\",\"prompt\":\"老火车站月台：雨夜中空旷的老式火车站月台，有复古木质长椅与散发暖黄色光晕的旧路灯，湿漉漉的地面倒映着灯光，铁轨延伸向迷蒙雨雾中。；默认：\\n小男孩：约7岁的小男孩，身穿亮黄色连帽雨衣和雨靴，兜帽下露出细碎黑发，眼神纯真而安静。；默认造型：\\n橘猫：毛茸茸的胖橘猫，毛发微湿，性格温顺黏人，蜷缩在男孩怀里。\\n大雨冲刷着夜色中的老火车站月台，暖黄色的路灯在湿漉地面晕开倒影。穿亮黄雨衣的小男孩独自坐在长椅上，双手紧抱着怀里的橘猫。（听见淅淅沥沥的雨声和远处闷雷声。）\",\"resolution\":\"480P\",\"sampler_name\":\"euler\",\"seed\":\"3529117410\",\"video_audio\":{},\"video_conditioning\":\"reference\",\"video_decode\":\"tiled\",\"video_excerpts\":[],\"video_overlap\":64,\"video_tile_size\":256,\"tier\":\"standard\"},\"simulation\":false,\"plan_id\":\"bc6c1918-db25-51d5-9cde-b1a3585c3b83\",\"project_id\":\"project-1d39fa642bb64f3babc89de38cc621a2\",\"artifacts\":[{\"id\":\"05e31c44-3dff-4470-b7f7-50fdc36e8fe5\",\"job_id\":\"fe8999d4-defc-4278-90c4-bbf5f4503999\",\"kind\":\"audio\",\"mime\":\"audio/flac\",\"size_bytes\":665215,\"sha256\":\"048e7149edbdd087bc30ffcb2568d8476ef558d99e64527cb53ac49e8a2a0abb\",\"metadata\":{\"content_type\":\"audio/flac\",\"delivery_spec\":{\"duration_s\":5.166666666666667,\"fps\":24,\"frame_count\":124,\"policy\":\"native-frames-r2-v1\",\"requested_duration_s\":5},\"duration_s\":5.166656,\"has_audio\":true,\"kind\":\"audio\",\"sha256\":\"048e7149edbdd087bc30ffcb2568d8476ef558d99e64527cb53ac49e8a2a0abb\",\"size_bytes\":665215,\"validated\":true},\"content_url\":\"/v1/artifacts/05e31c44-3dff-4470-b7f7-50fdc36e8fe5/content\",\"download_url\":\"/v1/artifacts/05e31c44-3dff-4470-b7f7-50fdc36e8fe5/content?download=1\"},{\"id\":\"3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\",\"job_id\":\"fe8999d4-defc-4278-90c4-bbf5f4503999\",\"kind\":\"video\",\"mime\":\"video/mp4\",\"size_bytes\":919399,\"sha256\":\"e13c4f16eceac2cfd2b6d7f0dfd27ab878935fc8d528742ccaee8e8a97d21698\",\"metadata\":{\"audio_duration_s\":5.167,\"container_duration_s\":5.167,\"content_type\":\"video/mp4\",\"delivery_spec\":{\"duration_s\":5.166666666666667,\"fps\":24,\"frame_count\":124,\"policy\":\"native-frames-r2-v1\",\"requested_duration_s\":5},\"duration_s\":5.166666666666667,\"fps\":24,\"frame_count\":124,\"has_audio\":true,\"height\":480,\"kind\":\"video\",\"quality_checks\":{\"burned_subtitles\":{\"detector\":\"dialogue-ocr-v1\",\"status\":\"no_dialogue\"}},\"quality_flags\":[],\"sha256\":\"e13c4f16eceac2cfd2b6d7f0dfd27ab878935fc8d528742ccaee8e8a97d21698\",\"size_bytes\":919399,\"validated\":true,\"width\":832,\"rendition_status\":\"ready\"},\"content_url\":\"/v1/artifacts/3ee134ae-a0cd-