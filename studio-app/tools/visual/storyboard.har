      "text": "{\"id\":\"project-1d39fa642bb64f3babc89de38cc621a2\",\"version\":9,\"updated_at\":1793145172.399084,\"project\":{\"entities\":[{\"data\":{},\"description\":\"\",\"id\":\"chapter-ebbac113d8d3590092dddc4133fc8c6d\",\"order\":0,\"parentId\":null,\"status\":\"draft\",\"title\":\"Story\",\"type\":\"chapter\",\"version\":1},{\"data\":{\"script\":\"\"},\"description\":\"\",\"id\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"order\":0,\"parentId\":\"chapter-ebbac113d8d3590092dddc4133fc8c6d\",\"status\":\"draft\",\"title\":\"Scene 1\",\"type\":\"scene\",\"version\":1},{\"data\":{\"defaultLookId\":\"main\",\"looks\":[{\"description\":\"\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-pic-d306d73baedf-a-24eef242b6e45f\"],\"name\":\"默认造型\",\"version\":2}],\"mainVoiceId\":\"\",\"voices\":[]},\"description\":\"约7岁的小男孩，身穿亮黄色连帽雨衣和雨靴，兜帽下露出细碎黑发，眼神纯真而安静。\",\"id\":\"character-420149b4acb8459ba624eef242b6e45f\",\"order\":1,\"parentId\":null,\"status\":\"draft\",\"title\":\"小男孩\",\"type\":\"character\",\"version\":2},{\"data\":{\"defaultLookId\":\"main\",\"looks\":[{\"description\":\"\",\"gallery\":{},\"id\":\"main\",\"imageIds\":[\"image-pic-d306d73baedf-a-e8d1f95fb14144\"],\"name\":\"默认造型\",\"version\":2}],\"mainVoiceId\":\"\",\"voices\":[]},\"description\":\"年轻女乘务员，二十岁出头，身穿深蓝色复古铁路制服和大檐帽，神情温柔亲切。\",\"id\":\"character-d8f989791ef8446eb9e8d1f95fb14144\",\"order\":2,\"parentId\":null,\"status\":\"draft\",\"title\":\"女乘务员\",\"type\":\"character\",\"version\":2},{\"data\":{\"ambient\":null,\"defaultVersionId\":\"main\",\"versions\":[{\"description\":\"\",\"id\":\"main\",\"imageIds\":[],\"name\":\"默认\",\"version\":1}]},\"description\":\"雨夜中空旷的老式火车站月台，有复古木质长椅与散发暖黄色光晕的旧路灯，湿漉漉的地面倒映着灯光，铁轨延伸向迷蒙雨雾中。\",\"id\":\"location-9d851b097e9f49a68ea7678f58a31fac\",\"order\":3,\"parentId\":null,\"status\":\"draft\",\"title\":\"老火车站月台\",\"type\":\"location\",\"version\":1},{\"data\":{\"imageIds\":[]},\"description\":\"毛茸茸的胖橘猫，毛发微湿，性格温顺黏人，蜷缩在男孩怀里。\",\"id\":\"prop-a14631c7e21241d4aabc9b5e82f7322d\",\"order\":4,\"parentId\":null,\"status\":\"draft\",\"title\":\"橘猫\",\"type\":\"prop\",\"version\":1},{\"data\":{\"imageIds\":[]},\"description\":\"深色折叠雨伞，伞面挂着晶莹雨滴。\",\"id\":\"prop-b69fd705745a4ef9998267908a496499\",\"order\":5,\"parentId\":null,\"status\":\"draft\",\"title\":\"雨伞\",\"type\":\"prop\",\"version\":1},{\"data\":{\"cast\":[{\"characterId\":\"character-420149b4acb8459ba624eef242b6e45f\",\"lookId\":\"\"}],\"prompt\":\"大雨冲刷着夜色中的老火车站月台，暖黄色的路灯在湿漉地面晕开倒影。穿亮黄雨衣的小男孩独自坐在长椅上，双手紧抱着怀里的橘猫。（听见淅淅沥沥的雨声和远处闷雷声。）\",\"seconds\":5,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-a14631c7e21241d4aabc9b5e82f7322d\"],\"quality\":\"draft\",\"version\":1},\"candidateIds\":[\"result-3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\"],\"selectedAssetId\":\"result-3ee134ae-a0cd-4013-b2f0-15a8d22fa97a\"},\"description\":\"大雨冲刷着夜色中的老火车站月台，暖黄色的路灯在湿漉地面晕开倒影。穿亮黄雨衣的小男孩独自坐在长椅上，双手紧抱着怀里的橘猫。（听见淅淅沥沥的雨声和远处闷雷声。）\",\"id\":\"shot-938a545b754e400681a1bd5dac8a6cb0\",\"order\":0,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":2},{\"data\":{\"cast\":[{\"characterId\":\"character-420149b4acb8459ba624eef242b6e45f\",\"lookId\":\"\"}],\"prompt\":\"特写镜头中，小男孩望向雨雾弥漫的铁轨尽头，怀里的橘猫乖巧抬头，雨水顺着男孩的雨衣兜帽滴落。（听见雨滴拍打雨衣的沙沙声和橘猫微弱的呼噜声。）\",\"seconds\":4,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-a14631c7e21241d4aabc9b5e82f7322d\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"特写镜头中，小男孩望向雨雾弥漫的铁轨尽头，怀里的橘猫乖巧抬头，雨水顺着男孩的雨衣兜帽滴落。（听见雨滴拍打雨衣的沙沙声和橘猫微弱的呼噜声。）\",\"id\":\"shot-e4d273e9d66e49109c46fa39eb1c4710\",\"order\":1,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":1},{\"data\":{\"cast\":[{\"characterId\":\"character-d8f989791ef8446eb9e8d1f95fb14144\",\"lookId\":\"\"}],\"prompt\":\"一身深蓝制服的年轻女乘务员撑着伞走过月台，脚步在积水里激起微小水花，忽然注意到了长椅上的小身影。（听见平稳踩水声与背景连绵的雨声。）\",\"seconds\":5,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-b69fd705745a4ef9998267908a496499\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"一身深蓝制服的年轻女乘务员撑着伞走过月台，脚步在积水里激起微小水花，忽然注意到了长椅上的小身影。（听见平稳踩水声与背景连绵的雨声。）\",\"id\":\"shot-a4c9b729a8c04133943d77b1dddee444\",\"order\":2,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":1},{\"data\":{\"cast\":[{\"characterId\":\"character-420149b4acb8459ba624eef242b6e45f\",\"lookId\":\"\"},{\"characterId\":\"character-d8f989791ef8446eb9e8d1f95fb14144\",\"lookId\":\"\"}],\"prompt\":\"女乘务员走近长椅并轻柔蹲下，将雨伞倾斜遮在小男孩和橘猫头顶，微笑着看向小男孩。（听见雨点密集敲击伞面的咚咚声，以及远处隐约的火车鸣笛。）\",\"seconds\":5,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-a14631c7e21241d4aabc9b5e82f7322d\",\"prop-b69fd705745a4ef9998267908a496499\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"女乘务员走近长椅并轻柔蹲下，将雨伞倾斜遮在小男孩和橘猫头顶，微笑着看向小男孩。（听见雨点密集敲击伞面的咚咚声，以及远处隐约的火车鸣笛。）\",\"id\":\"shot-485b3fdc96ac4cf4ad89ae6e6ebd549f\",\"order\":3,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":1},{\"data\":{\"cast\":[{\"characterId\":\"character-420149b4acb8459ba624eef242b6e45f\",\"lookId\":\"\"},{\"characterId\":\"character-d8f989791ef8446eb9e8d1f95fb14144\",\"lookId\":\"\"}],\"prompt\":\"一列老式客运列车伴随巨大的车灯光束破开雨雾缓缓进站，车厢窗户透出橙黄色的温暖光芒。（听见沉重的铁轨轰鸣与列车刹车时刺耳的蒸汽嘶嘶声。）\",\"seconds\":5,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-b69fd705745a4ef9998267908a496499\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"一列老式客运列车伴随巨大的车灯光束破开雨雾缓缓进站，车厢窗户透出橙黄色的温暖光芒。（听见沉重的铁轨轰鸣与列车刹车时刺耳的蒸汽嘶嘶声。）\",\"id\":\"shot-5be7619cf3af4724aecec4facb284543\",\"order\":4,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":1},{\"data\":{\"cast\":[{\"characterId\":\"character-420149b4acb8459ba624eef242b6e45f\",\"lookId\":\"\"},{\"characterId\":\"character-d8f989791ef8446eb9e8d1f95fb14144\",\"lookId\":\"\"}],\"prompt\":\"乘务员一手撑伞，另一只手温柔牵起抱着橘猫的小男孩，一起走向透着暖光的列车车厢门。（听见列车怠速的轰鸣与两人踏上车厢踏板的脚步声。）\",\"seconds\":5,\"storyboard\":{\"mode\":\"ref\",\"place\":{\"locationId\":\"location-9d851b097e9f49a68ea7678f58a31fac\"},\"propIds\":[\"prop-a14631c7e21241d4aabc9b5e82f7322d\",\"prop-b69fd705745a4ef9998267908a496499\"],\"quality\":\"draft\",\"version\":1}},\"description\":\"乘务员一手撑伞，另一只手温柔牵起抱着橘猫的小男孩，一起走向透着暖光的列车车厢门。（听见列车怠速的轰鸣与两人踏上车厢踏板的脚步声。）\",\"id\":\"shot-3f5ddf815b38418ba4c970a157f94cfd\",\"order\":5,\"parentId\":\"scene-263a1532bd1d5dfbbfb16f9ca00d4ed3\",\"status\":\"draft\",\"title\":\"\",\"type\":\"shot\",\"version\":1},{\"data\":{\"cloudAssetId\":\"bdd681dff19c4fb5974fdd6577f2b06c\",\"cloudContentPath\":\"/v1/assets/bdd681dff19c4fb5974fdd6577f2b06c/content\",\"fileId\":\"cloud_asset_bdd681dff19c4fb5974fdd6577f2b06c\",\"fileName\":\"story-picture.jpg\",\"metadata\":{\"bytes\":422267,\"duration\":null,\"has_audio\":false,\"height\":1200,\"kind\":\"image\",\"mime\":\"image/jpeg\",\"model_ready\":true,\"notes\":[],\"sha256\":\"32115734d8109b6818747d39a0c0437dae470346a8d23e2eb785c51af39951b4\",\"source_duration\":null,\"width\":896},\"mime\":\"image/jpeg\",\"missingFile\":false,\"source\":\"upload\"},\"description\":\"\",\"id\":\"image-pic-d306d73baedf-a-24eef242b6e45f\",\"order\":6,\"parentId\":null,\"status\":\"draft\",\"title\":\"小男孩\",\"type\":\"image\",\"version\":1},{\"data\":{\"cloudAssetId\":\"7f5a2f3739544a2ca38d6c0cb53816ba\",\"cloudContentPath\":\"/v1/assets/7f5a2f3739544a2ca38d6c0cb53816ba/content\",\"fileId\":\"cloud_asset_7f5a2f3739544a2ca38d6c0cb53816ba\",\"fileName\":\"story-picture.jpg\",\"metadata\":{\"bytes\":368452,\"duration\":null,\"has_audio\":false,\"height\":1200,\"kind\":\"image\",\"mime\":\"image/jpeg\",\"model_ready\":true